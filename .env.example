# --- Base de données PostgreSQL (ex. Neon, neon.tech — gratuit) ---
# Colle ici la chaîne de connexion fournie par ton hébergeur Postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# Secret utilisé pour signer les sessions JWT. Génère le tien avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
# En local : http://localhost:3002 (port 3000 déjà pris par valorant-tracker)
# En production (Vercel) : l'URL publique du site, ex. https://mon-site.vercel.app
NEXTAUTH_URL="http://localhost:3002"
